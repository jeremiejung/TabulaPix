{
  "manifest_version": 3,
  "name": "Wire Sweep",
  "version": "1.3.0",
  "description": "Lance la même recherche sur toutes vos agences photo, un onglet par agence.",
  "action": {
    "default_title": "Wire Sweep",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "clipboardWrite", "scripting", "tabs"],
  "host_permissions": [
    "https://mercury.bloomberg.com/*",
    "https://search.abacapress.com/*",
    "https://*.pixpalace.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
